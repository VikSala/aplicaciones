<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_acc_clientes_boton" model="ir.ui.view">
        <field name="name">res.partner.form.acc.clientes.boton</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page string="Acceso Web" name="page_acceso_instalador_vfinal">
                    <header>
                        <button name="action_force_sync_access" 
                                string="FORZAR ACTUALIZACIÓN DE CONTRASEÑA" 
                                type="object" 
                                class="oe_highlight"/>
                    </header>
                    <group>
                        <group string="Configuración Directa">
                            <field name="x_inst_usuario"/>
                            <field name="x_inst_password" password="0"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>