<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_ontime_dimensions" model="ir.ui.view">
        <field name="name">product.template.form.ontime.dimensions</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="inside">
                <separator string="Dimensiones OnTime"/>
                <field name="ontime_length_cm" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                <field name="ontime_width_cm" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                <field name="ontime_height_cm" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
            </xpath>
        </field>
    </record>
</odoo>
