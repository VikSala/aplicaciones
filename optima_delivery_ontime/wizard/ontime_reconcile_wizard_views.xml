<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_ontime_reconcile_wizard_form" model="ir.ui.view">
        <field name="name">delivery.ontime.reconcile.wizard.form</field>
        <field name="model">delivery.ontime.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="Reconciliar operación OnTime">
                <group>
                    <field name="picking_id"/>
                    <field name="operation_state"/>
                    <field name="resolution"/>
                    <field name="reference" invisible="resolution != 'link_existing'" required="resolution == 'link_existing'"/>
                    <field name="note" placeholder="Indica cómo se ha comprobado el resultado en OnTime..."/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Usa esta acción únicamente después de comprobar el resultado real en OnTime.
                    Su objetivo es evitar duplicar una expedición o una cancelación tras un timeout.
                </div>
                <footer>
                    <button name="action_apply" string="Aplicar reconciliación" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
