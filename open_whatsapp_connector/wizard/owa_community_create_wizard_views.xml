<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_owa_community_create_wizard_form" model="ir.ui.view">
    <field name="name">owa.community.create.wizard.form</field>
    <field name="model">owa.community.create.wizard</field>
    <field name="arch" type="xml">
      <form string="Create WhatsApp Community">
        <sheet>
          <group>
            <field name="wa_account_id"/>
            <field name="subject" placeholder="e.g. Acme HQ"/>
            <field name="description" placeholder="Short description shown to members."/>
          </group>
        </sheet>
        <footer>
          <button name="action_create" type="object" string="Create Community"
                  class="btn-primary"/>
          <button special="cancel" string="Cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_owa_community_create_wizard" model="ir.actions.act_window">
    <field name="name">Create WhatsApp Community</field>
    <field name="res_model">owa.community.create.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
