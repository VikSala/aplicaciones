<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quick Reply Form View -->
    <record id="owa_quick_reply_view_form" model="ir.ui.view">
        <field name="name">owa.quick.reply.form</field>
        <field name="model">owa.quick.reply</field>
        <field name="arch" type="xml">
            <form string="Quick Reply">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="template_type" widget="radio"/>
                            <field name="wa_account_id"/>
                            <field name="model_id"/>
                            <field name="phone_field"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Header" invisible="template_type == 'text'">
                        <group>
                            <field name="header_type"/>
                            <field name="header_text"
                                   invisible="header_type != 'text'"
                                   placeholder="e.g. Order Confirmation"/>
                            <field name="header_attachment_id"
                                   invisible="header_type not in ('image', 'video', 'document')"/>
                        </group>
                    </group>
                    <group string="Message Body">
                        <field name="body" nolabel="1"
                               placeholder="Hello {{partner_name}}, your order {{order_name}} is ready!"/>
                    </group>
                    <group string="Footer" invisible="template_type == 'text'">
                        <field name="footer" nolabel="1"
                               placeholder="e.g. Powered by Our Company"/>
                    </group>
                    <group string="Buttons" invisible="template_type != 'button'">
                        <field name="button_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="text" placeholder="e.g. Yes, Confirm"/>
                                <field name="button_id" optional="hide"/>
                            </list>
                        </field>
                        <div class="text-muted" colspan="2">
                            Maximum 3 buttons. Each button text max 20 characters.
                        </div>
                    </group>
                    <group string="List Menu" invisible="template_type != 'list'">
                        <field name="list_button_text" placeholder="e.g. View Options"/>
                        <field name="list_section_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="title" placeholder="e.g. Products"/>
                                <field name="row_ids" widget="many2many_tags" optional="hide"/>
                            </list>
                        </field>
                        <div class="text-muted" colspan="2">
                            Maximum 10 rows total across all sections.
                        </div>
                    </group>
                    <group string="Variables" invisible="not variable_ids">
                        <field name="variable_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name" readonly="1"/>
                                <field name="field_path" placeholder="e.g. partner_id.name"/>
                                <field name="default_value"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List Section Form View (for editing rows) -->
    <record id="owa_quick_reply_list_section_view_form" model="ir.ui.view">
        <field name="name">owa.quick.reply.list.section.form</field>
        <field name="model">owa.quick.reply.list.section</field>
        <field name="arch" type="xml">
            <form string="List Section">
                <group>
                    <field name="title"/>
                    <field name="sequence"/>
                </group>
                <group string="Rows">
                    <field name="row_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="title" placeholder="e.g. Product A"/>
                            <field name="description" placeholder="e.g. $19.99 - Great value"/>
                            <field name="row_id" optional="hide"/>
                        </list>
                    </field>
                </group>
            </form>
        </field>
    </record>

    <!-- Quick Reply List View -->
    <record id="owa_quick_reply_view_list" model="ir.ui.view">
        <field name="name">owa.quick.reply.list</field>
        <field name="model">owa.quick.reply</field>
        <field name="arch" type="xml">
            <list string="Quick Replies">
                <field name="name"/>
                <field name="template_type"/>
                <field name="body" widget="char"/>
                <field name="wa_account_id"/>
                <field name="model_id"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="owa_quick_reply_action" model="ir.actions.act_window">
        <field name="name">Message Templates</field>
        <field name="res_model">owa.quick.reply</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first message template
            </p>
            <p>
                Create text, button, or list templates with {{variable}} placeholders.
            </p>
        </field>
    </record>
</odoo>
