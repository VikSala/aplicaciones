<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="owa_slash_command_action" model="ir.actions.act_window">
        <field name="name">Slash Commands</field>
        <field name="res_model">owa.slash.command</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="owa_slash_command_list" model="ir.ui.view">
        <field name="name">owa.slash.command.list</field>
        <field name="model">owa.slash.command</field>
        <field name="arch" type="xml">
            <list string="Slash Commands">
                <field name="sequence" widget="handle"/>
                <field name="command"/>
                <field name="name"/>
                <field name="description"/>
                <field name="handler"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="owa_slash_command_form" model="ir.ui.view">
        <field name="name">owa.slash.command.form</field>
        <field name="model">owa.slash.command</field>
        <field name="arch" type="xml">
            <form string="Slash Command">
                <sheet>
                    <group>
                        <field name="command" placeholder="/help"/>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="handler"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
