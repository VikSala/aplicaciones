<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Chatbot Form View -->
    <record id="owa_chatbot_form" model="ir.ui.view">
        <field name="name">owa.chatbot.form</field>
        <field name="model">owa.chatbot</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Chatbot">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Customer Support Bot"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="wa_account_id"/>
                            <field name="session_timeout_minutes"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="welcome_message" placeholder="Hello! How can I help you today?"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Steps" name="steps">
                            <field name="step_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="step_type"/>
                                    <field name="message" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Chatbot List View -->
    <record id="owa_chatbot_list" model="ir.ui.view">
        <field name="name">owa.chatbot.list</field>
        <field name="model">owa.chatbot</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Chatbots">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="wa_account_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Chatbot Step Form View -->
    <record id="owa_chatbot_step_form" model="ir.ui.view">
        <field name="name">owa.chatbot.step.form</field>
        <field name="model">owa.chatbot.step</field>
        <field name="arch" type="xml">
            <form string="Chatbot Step">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="step_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="message" placeholder="Message to send at this step..."/>
                            <field name="next_step_id"
                                   invisible="step_type not in ('message', 'create_lead')"
                                   domain="[('chatbot_id', '=', parent.chatbot_id)]"/>
                            <field name="target_user_id"
                                   invisible="step_type != 'route_to_user'"/>
                        </group>
                    </group>
                    <field name="option_ids" invisible="step_type != 'menu'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="label"/>
                            <field name="keyword"/>
                            <field name="next_step_id"
                                   domain="[('chatbot_id', '=', parent.chatbot_id)]"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Chatbot Session List View -->
    <record id="owa_chatbot_session_list" model="ir.ui.view">
        <field name="name">owa.chatbot.session.list</field>
        <field name="model">owa.chatbot.session</field>
        <field name="arch" type="xml">
            <list string="Chatbot Sessions" decoration-muted="state in ('completed', 'expired')">
                <field name="chatbot_id"/>
                <field name="phone_number"/>
                <field name="current_step_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'routed'"
                       decoration-muted="state in ('completed', 'expired')"/>
                <field name="last_activity"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="owa_chatbot_action" model="ir.actions.act_window">
        <field name="name">Chatbots</field>
        <field name="res_model">owa.chatbot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WhatsApp chatbot
            </p>
            <p>
                Build interactive chatbots with menus, routing to agents,
                and CRM lead creation.
            </p>
        </field>
    </record>

    <record id="owa_chatbot_session_action" model="ir.actions.act_window">
        <field name="name">Chatbot Sessions</field>
        <field name="res_model">owa.chatbot.session</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
