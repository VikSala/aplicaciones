<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_owa_customer360" model="ir.actions.client">
        <field name="name">WhatsApp Customer Timeline</field>
        <field name="tag">owa_customer360</field>
    </record>

    <!-- Smart button on partner form -->
    <record id="res_partner_view_form_owa_360" model="ir.ui.view">
        <field name="name">res.partner.form.owa.360</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="action" icon="fa-history"
                        name="%(open_whatsapp_connector.action_owa_customer360)d"
                        context="{'default_partner_id': id, 'partner_id': id}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Customer</span>
                        <span class="o_stat_text">360°</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
