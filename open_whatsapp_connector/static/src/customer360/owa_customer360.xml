<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="open_whatsapp_connector.OwaCustomer360">
        <div class="owa_customer360">
            <t t-if="state.loading">
                <div class="owa360_loader">
                    <i class="fa fa-spinner fa-spin"/> <span>Loading timeline…</span>
                </div>
            </t>
            <t t-elif="state.error">
                <div class="owa360_error">
                    <i class="fa fa-exclamation-triangle"/> <span t-esc="state.error"/>
                </div>
            </t>
            <t t-else="">
                <div class="owa360_header">
                    <div class="owa360_partner">
                        <h2 t-esc="state.partner.name"/>
                        <div class="owa360_partner_meta">
                            <span t-if="state.partner.mobile" class="owa360_meta_chip">
                                <i class="fa fa-mobile"/> <t t-esc="state.partner.mobile"/>
                            </span>
                            <span t-if="state.partner.phone" class="owa360_meta_chip">
                                <i class="fa fa-phone"/> <t t-esc="state.partner.phone"/>
                            </span>
                            <span t-if="state.partner.email" class="owa360_meta_chip">
                                <i class="fa fa-envelope"/> <t t-esc="state.partner.email"/>
                            </span>
                        </div>
                    </div>
                    <div class="owa360_summary">
                        <strong t-esc="state.total"/> <span> events</span>
                    </div>
                </div>

                <div class="owa360_timeline">
                    <t t-foreach="state.events" t-as="ev" t-key="ev_index">
                        <div t-att-class="'owa360_event owa360_color_' + ev.color"
                             t-on-click="() => this.open(ev)">
                            <div class="owa360_event_icon">
                                <i t-att-class="'fa ' + ev.icon"/>
                            </div>
                            <div class="owa360_event_body">
                                <div class="owa360_event_summary" t-esc="ev.summary"/>
                                <div class="owa360_event_meta">
                                    <span class="owa360_event_type" t-esc="ev.type"/>
                                    <span class="owa360_event_dt" t-esc="ev.datetime"/>
                                </div>
                            </div>
                        </div>
                    </t>
                    <div t-if="state.events.length === 0" class="owa360_empty">
                        No events yet for this contact.
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
