<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Account: restricted by company -->
    <record id="owa_account_company_rule" model="ir.rule">
        <field name="name">Open WhatsApp Connector Account: Company</field>
        <field name="model_id" ref="model_owa_account"/>
        <field name="domain_force">[('allowed_company_ids', 'in', company_ids)]</field>
    </record>

    <!-- Messages: users see only their own, admins see all -->
    <record id="owa_message_user_rule" model="ir.rule">
        <field name="name">Open WhatsApp Connector Message: User</field>
        <field name="model_id" ref="model_owa_message"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="owa_message_admin_rule" model="ir.rule">
        <field name="name">Open WhatsApp Connector Message: Admin</field>
        <field name="model_id" ref="model_owa_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('open_whatsapp_connector.group_owa_admin'))]"/>
    </record>

    <!-- Phase 13: company isolation by tying every account-linked record to the
         account's allowed_company_ids. Records without wa_account_id (e.g.
         standalone quick replies / contact lists) are global. -->

    <record id="owa_message_company_rule" model="ir.rule">
        <field name="name">WhatsApp Message: Company (via account)</field>
        <field name="model_id" ref="model_owa_message"/>
        <field name="domain_force">['|', ('wa_account_id', '=', False), ('wa_account_id.allowed_company_ids', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="owa_campaign_company_rule" model="ir.rule">
        <field name="name">WhatsApp Campaign: Company (via account)</field>
        <field name="model_id" ref="model_owa_campaign"/>
        <field name="domain_force">['|', ('wa_account_id', '=', False), ('wa_account_id.allowed_company_ids', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
