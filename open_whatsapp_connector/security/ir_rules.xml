    <!-- Phase 22C / 27B: inbound rules — scope by company on BOTH the
         account-linked case (via account.allowed_company_ids) AND the
         account-less case (via rule.company_id). Without the company_id
         fallback an account-less rule in Company A would otherwise be
         visible (and fireable) from Company B. -->
    <record id="owa_inbound_rule_company_rule" model="ir.rule">
        <field name="name">WhatsApp Inbound Rule: Company (via account or company_id)</field>
        <field name="model_id" ref="model_owa_inbound_rule"/>
        <field name="domain_force">['|', '&amp;', ('wa_account_id', '=', False), ('company_id', 'in', company_ids), ('wa_account_id.allowed_company_ids', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

