    <!-- ================================================================
         Per-user / per-team visibility for marketing records.
         SHIPPED INACTIVE. The "Campaign & Contact Visibility" setting
         (res.config.settings.owa_marketing_visibility) flips these on
         when an admin selects "Restricted to owner + their Sales Team".
         When inactive (default), only the global company rules apply, so
         everyone in the company sees all (today's shared behaviour).

         Each model gets a pair:
           - user rule  (base.group_user): own OR member/leader of the team
           - admin rule (group_owa_admin): unrestricted (1=1)
         Group-scoped rules OR together, so an admin (who implies
         base.group_user) sees (own|team) OR all = all.
         ================================================================ -->

    <!-- Campaign -->
    <record id="owa_campaign_user_rule" model="ir.rule">
        <field name="name">WhatsApp Campaign: own + team</field>
        <field name="model_id" ref="model_owa_campaign"/>
        <field name="active" eval="False"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), '|', ('team_id.member_ids', 'in', [user.id]), ('team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="owa_campaign_admin_all_rule" model="ir.rule">
        <field name="name">WhatsApp Campaign: admin all</field>
        <field name="model_id" ref="model_owa_campaign"/>
        <field name="active" eval="False"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('open_whatsapp_connector.group_owa_admin'))]"/>
    </record>

