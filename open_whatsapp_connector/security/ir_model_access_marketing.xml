        <field name="active" eval="False"/>
    </record>

    <record id="access_owa_status_broadcast_user_manage" model="ir.model.access">
        <field name="name">owa.status.broadcast.user.manage</field>
        <field name="model_id" ref="model_owa_status_broadcast"/>
