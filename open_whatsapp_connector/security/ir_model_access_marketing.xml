        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="active" eval="False"/>
    </record>

    <record id="access_owa_standing_order_user_manage" model="ir.model.access">
        <field name="name">owa.standing.order.user.manage</field>
        <field name="model_id" ref="model_owa_standing_order"/>
