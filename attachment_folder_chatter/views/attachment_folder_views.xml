<odoo>
    <!-- Vista tipo chatter/galería para los adjuntos de una carpeta -->
    <record id="view_ir_attachment_folder_kanban" model="ir.ui.view">
        <field name="name">ir.attachment.folder.kanban</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <kanban class="o_attachment_folder_kanban" create="true" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="mimetype"/>
                <field name="create_date"/>
                <field name="file_size"/>
                <field name="folder_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_attachment_folder_card">
                            <a t-attf-href="/web/content/#{record.id.raw_value}?download=false"
                               target="_blank"
                               class="o_attachment_folder_thumb"
                               title="Previsualizar">
                                <t t-if="record.mimetype.raw_value and record.mimetype.raw_value.indexOf('image/') === 0">
                                    <img t-attf-src="/web/image/ir.attachment/#{record.id.raw_value}/datas"
                                         alt="Vista previa"/>
                                </t>
                                <t t-elif="record.mimetype.raw_value == 'application/pdf'">
                                    <i class="fa fa-file-pdf-o o_attachment_folder_icon text-danger"/>
                                </t>
                                <t t-elif="record.mimetype.raw_value and record.mimetype.raw_value.indexOf('video/') === 0">
                                    <i class="fa fa-file-video-o o_attachment_folder_icon text-primary"/>
                                </t>
                                <t t-elif="record.mimetype.raw_value and record.mimetype.raw_value.indexOf('audio/') === 0">
                                    <i class="fa fa-file-audio-o o_attachment_folder_icon text-primary"/>
                                </t>
                                <t t-else="">
                                    <i class="fa fa-file-o o_attachment_folder_icon text-muted"/>
                                </t>
                            </a>
                            <div class="o_attachment_folder_body">
                                <a t-attf-href="/web/content/#{record.id.raw_value}?download=false"
                                   target="_blank"
                                   class="o_attachment_folder_name"
                                   title="Previsualizar">
                                    <field name="name"/>
                                </a>
                                <div class="o_attachment_folder_meta">
                                    <field name="mimetype"/>
                                </div>
                                <div class="o_attachment_folder_meta">
                                    <field name="file_size" widget="integer"/> bytes
                                </div>
                                <div class="o_attachment_folder_actions">
                                    <a t-attf-href="/web/content/#{record.id.raw_value}?download=false" target="_blank">
                                        <i class="fa fa-eye"/> Ver
                                    </a>
                                    <a t-attf-href="/web/content/#{record.id.raw_value}?download=true">
                                        <i class="fa fa-download"/> Descargar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ir_attachment_folder_list" model="ir.ui.view">
        <field name="name">ir.attachment.folder.list</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <list string="Adjuntos">
                <field name="name"/>
                <field name="mimetype"/>
                <field name="create_date"/>
                <field name="folder_id"/>
            </list>
        </field>
    </record>

    <record id="view_ir_attachment_folder_form" model="ir.ui.view">
        <field name="name">ir.attachment.folder.form</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <form string="Adjunto">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="datas" filename="name"/>
                        <field name="folder_id" readonly="1"/>
                        <field name="res_model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                        <field name="mimetype" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_attachment_folder_tree" model="ir.ui.view">
        <field name="name">attachment.folder.tree</field>
        <field name="model">attachment.folder</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="full_name" readonly="1"/>
                <field name="sale_order_id"/>
                <field name="project_task_id"/>
                <field name="attachment_count" readonly="1"/>
                <button name="action_open_attachments"
                        type="object"
                        string="Ver archivos"
                        class="btn-secondary"/>
                <button name="action_open_upload_wizard"
                        type="object"
                        string="Subir varios"
                        class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_attachment_folder_form" model="ir.ui.view">
        <field name="name">attachment.folder.form</field>
        <field name="model">attachment.folder</field>
        <field name="arch" type="xml">
            <form string="Carpeta de adjuntos">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_attachments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Archivos"/>
                        </button>
                        <button name="action_open_upload_wizard"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-upload"
                                string="Subir varios"/>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="sale_order_id"/>
                            <field name="project_task_id"/>
                        </group>
                        <group>
                            <field name="full_name" readonly="1"/>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Archivos">
                            <field name="attachment_ids"
                                   mode="kanban,list"
                                   context="{'default_folder_id': id, 'default_res_model': res_model, 'default_res_id': res_id}">
                                <kanban class="o_attachment_folder_kanban" create="true" quick_create="false">
                                    <field name="id"/>
                                    <field name="name"/>
                                    <field name="mimetype"/>
                                    <field name="file_size"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="o_attachment_folder_card">
                                                <a t-attf-href="/web/content/#{record.id.raw_value}?download=false"
                                                   target="_blank"
                                                   class="o_attachment_folder_thumb"
                                                   title="Previsualizar">
                                                    <t t-if="record.mimetype.raw_value and record.mimetype.raw_value.indexOf('image/') === 0">
                                                        <img t-attf-src="/web/image/ir.attachment/#{record.id.raw_value}/datas"
                                                             alt="Vista previa"/>
                                                    </t>
                                                    <t t-elif="record.mimetype.raw_value == 'application/pdf'">
                                                        <i class="fa fa-file-pdf-o o_attachment_folder_icon text-danger"/>
                                                    </t>
                                                    <t t-elif="record.mimetype.raw_value and record.mimetype.raw_value.indexOf('video/') === 0">
                                                        <i class="fa fa-file-video-o o_attachment_folder_icon text-primary"/>
                                                    </t>
                                                    <t t-else="">
                                                        <i class="fa fa-file-o o_attachment_folder_icon text-muted"/>
                                                    </t>
                                                </a>
                                                <div class="o_attachment_folder_body">
                                                    <a t-attf-href="/web/content/#{record.id.raw_value}?download=false"
                                                       target="_blank"
                                                       class="o_attachment_folder_name"
                                                       title="Previsualizar">
                                                        <field name="name"/>
                                                    </a>
                                                    <div class="o_attachment_folder_meta"><field name="mimetype"/></div>
                                                    <div class="o_attachment_folder_meta"><field name="file_size" widget="integer"/> bytes</div>
                                                    <div class="o_attachment_folder_actions">
                                                        <a t-attf-href="/web/content/#{record.id.raw_value}?download=false" target="_blank">
                                                            <i class="fa fa-eye"/> Ver
                                                        </a>
                                                        <a t-attf-href="/web/content/#{record.id.raw_value}?download=true">
                                                            <i class="fa fa-download"/> Descargar
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="datas" filename="name"/>
                                    <field name="mimetype" readonly="1"/>
                                    <field name="create_date" readonly="1"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="datas" filename="name"/>
                                            <field name="folder_id" readonly="1"/>
                                            <field name="res_model" readonly="1"/>
                                            <field name="res_id" readonly="1"/>
                                            <field name="mimetype" readonly="1"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Subcarpetas">
                            <field name="child_ids" context="{'default_parent_id': id, 'default_sale_order_id': sale_order_id, 'default_project_task_id': project_task_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="attachment_count" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_attachment_folder_upload_wizard_form" model="ir.ui.view">
        <field name="name">attachment.folder.upload.wizard.form</field>
        <field name="model">attachment.folder.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Subir varios archivos">
                <sheet>
                    <group>
                        <field name="folder_id"/>
                    </group>
                    <group string="Archivos">
                        <p class="text-muted">
                            Puedes seleccionar varios archivos a la vez o arrastrarlos sobre el campo inferior.
                        </p>
                        <field name="attachment_ids"
                               widget="many2many_binary"
                               nolabel="1"
                               context="{'default_folder_id': folder_id}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_upload_files"
                            type="object"
                            string="Subir a carpeta"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attachment_folder" model="ir.actions.act_window">
        <field name="name">Carpetas de adjuntos</field>
        <field name="res_model">attachment.folder</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_attachment_folder_root"
              name="Carpetas de adjuntos"
              parent="base.menu_custom"
              action="action_attachment_folder"/>
</odoo>
