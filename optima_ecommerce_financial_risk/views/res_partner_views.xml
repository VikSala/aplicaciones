<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_financial_risk_ecommerce" model="ir.ui.view">
        <field name="name">res.partner.financial.risk.ecommerce</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account_financial_risk.res_partner_view_risk"/>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='financial_risk']" position="inside">
                <group string="Riesgo Ecommerce">
                    <group>
                        <field
                            name="ecommerce_risk_synced"
                            widget="monetary"
                            options="{'currency_field': 'risk_currency_id'}"
                        />
                        <field
                            name="ecommerce_risk_sync_date"
                            readonly="1"
                        />
                    </group>
                    <group>
                        <field
                            name="risk_total"
                            string="Riesgo Odoo Instalaciones"
                            widget="monetary"
                            options="{'currency_field': 'risk_currency_id'}"
                            readonly="1"
                        />
                        <field
                            name="total_risk_synced"
                            widget="monetary"
                            options="{'currency_field': 'risk_currency_id'}"
                            readonly="1"
                            class="oe_subtotal_footer_separator"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
