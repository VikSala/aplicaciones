<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="catalog_template_view">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <style>
                        .catalog-table { width: 100%; border-collapse: separate; border-spacing: 10px; table-layout: fixed; }
                        .product-card { 
                            border: 1px solid #eee; 
                            padding: 10px; 
                            text-align: center; 
                            vertical-align: top; 
                            background-color: #fff;
                            border-radius: 8px;
                            page-break-inside: avoid !important; /* EVITA QUE SE CORTE EL PRODUCTO */
                        }
                        .img-container { height: 120px; display: flex; align-items: center; justify-content: center; margin-bottom: 5px; }
                        .product-name { font-weight: bold; font-size: 11px; height: 30px; overflow: hidden; line-height: 1.2; }
                        .product-ref { color: #666; font-size: 9px; }
                        .product-stock { font-size: 9px; margin: 5px 0; }
                        .product-price { color: #714B67; font-weight: bold; font-size: 14px; margin: 5px 0; }
                        .btn-store { 
                            background-color: #714B67; color: white !important; 
                            padding: 4px; text-decoration: none; 
                            font-size: 9px; border-radius: 4px; display: block; 
                        }
                    </style>

                    <div class="text-center mb-4">
                        <h2 style="border-bottom: 2px solid #714B67; padding-bottom: 10px;">Catálogo de Productos</h2>
                        <p class="text-muted small">Fecha: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></p>
                    </div>

                    <table class="catalog-table">
                        <t t-set="columns" t-value="4"/>
                        <t t-set="count" t-value="0"/>
                        
                        <tr t-foreach="[docs[i:i + columns] for i in range(0, len(docs), columns)]" t-as="row_products">
                            <t t-foreach="row_products" t-as="product">
                                <td class="product-card">
                                    <div class="img-container">
                                        <img t-if="product.image_1920" t-att-src="image_data_uri(product.image_1920)" style="max-height: 110px; max-width: 100%;"/>
                                        <img t-if="not product.image_1920" src="/web/static/img/placeholder.png" style="max-height: 80px; opacity: 0.3;"/>
                                    </div>
                                    
                                    <div class="product-name"><span t-field="product.name"/></div>
                                    <div class="product-ref">Ref: <span t-field="product.default_code"/></div>
                                    
                                    <div class="product-stock">
                                        <span style="border: 1px solid #ddd; padding: 1px 4px; border-radius: 3px;">
                                            Stock: <t t-esc="product.qty_available"/>
                                        </span>
                                    </div>

                                    <div class="product-price">
                                        <span t-field="product.list_price" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/>
                                    </div>

                                    <a t-attf-href="/shop/product/#{product.id}" class="btn-store">Ver en Tienda</a>
                                </td>
                                <t t-set="count" t-value="count + 1"/>
                            </t>
                            
                            <t t-if="len(row_products) &lt; columns">
                                <t t-foreach="range(columns - len(row_products))" t-as="empty">
                                    <td style="border: none;"></td>
                                </t>
                            </t>

                            <t t-if="count % 20 == 0 and count &lt; len(docs)">
                                <t t-out='"&lt;/table&gt;&lt;p style=\"page-break-after: always;\"&gt;&lt;/p&gt;&lt;table class=\"catalog-table\"&gt;"' t-options="{'widget': 'safe_html'}"/>
                            </t>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>