<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="gls_asm_parcelshop_search_wizard_form" model="ir.ui.view">
        <field name="name">gls.asm.parcelshop.search.wizard.form</field>
        <field name="model">gls.asm.parcelshop.search.wizard</field>
        <field name="arch" type="xml">
            <form string="GLS ParcelShop Search">
                <group>
                    <group>
                        <field name="carrier_id" />
                        <field name="postal_code" placeholder="03001" />
                        <field name="country_id" options="{'no_create': True}" />
                    </group>
                    <group>
                        <field name="networks" />
                        <field name="result_count" invisible="not search_done" />
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    Enter a postal code and press Search. Network 1 searches all GLS
                    ParcelShop networks documented for the selected country.
                </div>
                <div class="alert alert-warning" role="alert" invisible="not search_done or result_count != 0">
                    GLS did not return any ParcelShop for this search.
                </div>
                <field name="line_ids" nolabel="1" readonly="1" invisible="not search_done">
                    <list create="0" delete="0">
                        <field name="sequence" column_invisible="True" />
                        <field name="code" />
                        <field name="network_id" optional="show" />
                        <field name="name" />
                        <field name="full_address" />
                        <field name="distance" optional="show" />
                        <field name="schedule" optional="show" />
                        <field name="latitude" optional="hide" />
                        <field name="longitude" optional="hide" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_search"
                        string="Search"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Close" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
