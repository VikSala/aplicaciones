<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="gls_asm_parcelshop_search_wizard_view_form" model="ir.ui.view">
        <field name="name">gls.asm.parcelshop.search.wizard.form</field>
        <field name="model">gls.asm.parcelshop.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Search GLS ParcelShops">
                <group>
                    <field name="carrier_id" invisible="1" />
                    <group>
                        <field name="zip_code" placeholder="03001" />
                        <field name="country_code" />
                    </group>
                    <group>
                        <field name="distance" />
                        <field name="max_results" />
                        <field name="parcelshop_type" />
                    </group>
                </group>
                <separator string="Results" />
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="parcelshop_id" />
                        <field name="shop_type" />
                        <field name="name" />
                        <field name="address" />
                        <field name="distance" />
                        <field name="latitude" optional="hide" />
                        <field name="longitude" optional="hide" />
                        <field name="opening_hours" optional="hide" />
                    </list>
                    <form string="GLS ParcelShop">
                        <group>
                            <group>
                                <field name="parcelshop_id" />
                                <field name="shop_type" />
                                <field name="name" />
                                <field name="address" />
                                <field name="distance" />
                            </group>
                            <group>
                                <field name="latitude" />
                                <field name="longitude" />
                                <field name="opening_hours" />
                            </group>
                        </group>
                    </form>
                </field>
                <footer>
                    <button
                        name="action_search"
                        string="Search"
                        type="object"
                        class="oe_highlight"
                        icon="fa-search"
                    />
                    <button string="Close" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
