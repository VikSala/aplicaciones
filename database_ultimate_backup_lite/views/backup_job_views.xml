<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_backup_job_list" model="ir.ui.view">
        <field name="name">backup.job.list</field>
        <field name="model">backup.job</field>
        <field name="arch" type="xml">
            <list string="Backup Jobs" decoration-success="status == 'success'" decoration-danger="status == 'error'" decoration-warning="status in ('running', 'warning')">
                <field name="display_name"/>
                <field name="config_id"/>
                <field name="database_name"/>
                <field name="backup_format"/>
                <field name="start_time"/>
                <field name="duration" widget="float_time"/>
                <field name="backup_size_human"/>
                <field name="verification_status" widget="badge" decoration-success="verification_status == 'verified'" decoration-danger="verification_status == 'failed'"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'error'" decoration-warning="status in ('running', 'warning')" decoration-info="status == 'pending'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_backup_job_form" model="ir.ui.view">
        <field name="name">backup.job.form</field>
        <field name="model">backup.job</field>
        <field name="arch" type="xml">
            <form string="Backup Job" create="false" edit="false">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="pending,running,success,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Basic Information">
                            <field name="config_id"/>
                            <field name="database_name"/>
                            <field name="backup_format"/>
                            <field name="backup_filename"/>
                        </group>
                        <group string="Timing">
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Backup Details">
                            <field name="backup_size_mb" invisible="1"/>
                            <field name="backup_size_human"/>
                            <field name="verification_status" widget="badge" decoration-success="verification_status == 'verified'" decoration-danger="verification_status == 'failed'"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Backup Details">
                            <field name="backup_details" readonly="1"/>
                        </page>
                        
                        <page string="Provider Results">
                            <field name="provider_results" readonly="1"/>
                        </page>
                        
                        <page string="Verification Details" invisible="verification_status not in ['verified', 'failed']">
                            <field name="verification_details" readonly="1"/>
                        </page>
                        
                        <page string="Error Details" invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </page>
                        
                        <page string="Log Entries">
                            <field name="log_entries" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_backup_job_search" model="ir.ui.view">
        <field name="name">backup.job.search</field>
        <field name="model">backup.job</field>
        <field name="arch" type="xml">
            <search string="Backup Jobs">
                <field name="display_name" string="Job"/>
                <field name="config_id" string="Configuration"/>
                <field name="database_name" string="Database"/>

                <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Error" name="error" domain="[('status', '=', 'error')]"/>
                <filter string="Warning" name="warning" domain="[('status', '=', 'warning')]"/>
                <filter string="Running" name="running" domain="[('status', '=', 'running')]"/>
                <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>

                <separator/>
                <filter string="Start Time" name="filter_start_time" date="start_time"/>

                <separator/>
                <filter string="Verified" name="verified" domain="[('verification_status', '=', 'verified')]"/>
                <filter string="Verification Failed" name="verification_failed" domain="[('verification_status', '=', 'failed')]"/>

                <group>
                    <filter string="Configuration" name="group_config" context="{'group_by': 'config_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Database" name="group_database" context="{'group_by': 'database_name'}"/>
                    <filter string="Start Date" name="group_date" context="{'group_by': 'start_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_backup_job" model="ir.actions.act_window">
        <field name="name">Backup Jobs</field>
        <field name="res_model">backup.job</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No backup jobs found
            </p>
            <p>
                Backup jobs will appear here when you create backups from your configurations.
                Each job tracks the execution, timing, and results of individual backup operations.
            </p>
        </field>
    </record>
</odoo>