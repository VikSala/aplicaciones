<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The backup menus are placed inside the Odoo Settings application instead
        of creating a standalone application tile in the main app launcher.

        parent="base.menu_administration" = Settings / Ajustes
        sequence close to the technical menus so it appears in the upper Settings bar
        near "Technical" / "Técnico".
    -->
    <menuitem
        id="database_ultimate_backup_menu_root"
        name="Backups"
        parent="base.menu_administration"
        sequence="95"
        groups="base.group_system">

        <menuitem
            id="menu_backup_configurations"
            name="Backup Configurations"
            action="action_backup_config"
            sequence="10"
        />

        <menuitem
            id="menu_backup_jobs"
            name="Backup Jobs"
            action="action_backup_job"
            sequence="20"
        />

        <menuitem
            id="menu_storage_providers"
            name="Storage Providers"
            sequence="30">

            <menuitem
                id="menu_local_providers"
                name="Local Storage"
                action="action_backup_provider_local"
                sequence="10"
            />

            <menuitem
                id="menu_sftp_providers"
                name="SFTP Storage"
                action="action_backup_provider_sftp"
                sequence="20"
            />

        </menuitem>

    </menuitem>

</odoo>
