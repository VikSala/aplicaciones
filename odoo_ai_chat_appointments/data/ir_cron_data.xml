<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_expire_odoo_ai_appointment_sessions" model="ir.cron">
        <field name="name">AI Chat Citas: caducar sesiones abandonadas</field>
        <field name="model_id" ref="model_odoo_ai_appointment_session"/>
        <field name="state">code</field>
        <field name="code">model.action_expire_stale_sessions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_cleanup_odoo_ai_appointment_ai_jobs" model="ir.cron">
        <field name="name">AI Chat Citas: limpiar jobs de fallback IA</field>
        <field name="model_id" ref="model_odoo_ai_appointment_ai_job"/>
        <field name="state">code</field>
        <field name="code">model.action_cleanup_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
