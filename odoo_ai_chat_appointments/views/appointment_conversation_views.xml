<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_odoo_ai_appointment_conversation_wizard_form" model="ir.ui.view">
        <field name="name">odoo.ai.appointment.conversation.wizard.form</field>
        <field name="model">odoo.ai.appointment.conversation.wizard</field>
        <field name="arch" type="xml">
            <form string="Probar conversación — Fase 7.2">
                <sheet>
                    <group>
                        <group>
                            <field name="session_id" options="{'no_open': False}"/>
                            <field name="current_state"/>
                        </group>
                        <group>
                            <field name="handled"/>
                            <field name="fallback"/>
                            <field name="ai_used"/>
                            <field name="ai_error" invisible="not ai_error"/>
                        </group>
                    </group>

                    <group string="Enviar mensaje">
                        <field name="user_message" placeholder="Ej.: Quiero fisioterapia"/>
                        <button name="action_send" string="Enviar" type="object" class="btn-primary"/>
                        <button name="action_reset" string="Reiniciar prueba" type="object" class="btn-secondary"/>
                    </group>

                    <group string="Última respuesta">
                        <field name="bot_reply" nolabel="1" readonly="1"/>
                    </group>

                    <separator string="Histórico de esta prueba"/>
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="role"/>
                            <field name="message"/>
                            <field name="handled"/>
                            <field name="fallback"/>
                            <field name="ai_used"/>
                            <field name="ai_error" optional="hide"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_odoo_ai_appointment_conversation_wizard" model="ir.actions.act_window">
        <field name="name">Probar conversación</field>
        <field name="res_model">odoo.ai.appointment.conversation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_odoo_ai_appointment_conversation_wizard"
              name="Probar conversación"
              parent="menu_odoo_ai_chat_appointments_root"
              action="action_odoo_ai_appointment_conversation_wizard"
              sequence="16"
              groups="base.group_system"/>
</odoo>
