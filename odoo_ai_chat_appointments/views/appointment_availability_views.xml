<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_odoo_ai_appointment_availability_wizard_form" model="ir.ui.view">
        <field name="name">odoo.ai.appointment.availability.wizard.form</field>
        <field name="model">odoo.ai.appointment.availability.wizard</field>
        <field name="arch" type="xml">
            <form string="Probar disponibilidad">
                <group>
                    <group string="Qué buscar">
                        <field name="service_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="eligible_employee_ids" invisible="1"/>
                        <field name="employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="max_results"/>
                    </group>
                    <group string="Preferencia">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="time_from" widget="float_time"/>
                        <field name="time_to" widget="float_time"/>
                    </group>
                </group>

                <separator string="Huecos disponibles"/>
                <field name="result_count" invisible="1"/>
                <field name="line_ids" nolabel="1" readonly="1">
                    <list create="0" delete="0" edit="0" default_order="sequence">
                        <field name="sequence" string="#"/>
                        <field name="employee_id"/>
                        <field name="start_local"/>
                        <field name="end_local"/>
                        <field name="timezone" optional="show"/>
                        <field name="start" optional="hidden"/>
                        <field name="end" optional="hidden"/>
                    </list>
                </field>
                <div class="text-muted" invisible="result_count != 0">
                    Pulsa <strong>Calcular disponibilidad</strong>. Si después del cálculo no aparece ninguna línea,
                    no existe un hueco compatible en el rango solicitado.
                </div>
                <footer>
                    <button name="action_calculate"
                            string="Calcular disponibilidad"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_odoo_ai_appointment_availability_wizard" model="ir.actions.act_window">
        <field name="name">Probar disponibilidad</field>
        <field name="res_model">odoo.ai.appointment.availability.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_odoo_ai_appointment_availability"
              name="Probar disponibilidad"
              parent="menu_odoo_ai_chat_appointments_root"
              action="action_odoo_ai_appointment_availability_wizard"
              sequence="15"
              groups="base.group_system"/>
</odoo>
