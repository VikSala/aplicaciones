<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Navegación compartida por escritorio y móvil -->
    <template id="cabrera_portal_navigation" name="Navegación portal B2B">
        <nav class="cabrera-portal-nav" aria-label="Navegación de mi cuenta">
            <a href="/my/home" t-attf-class="cabrera-nav-item #{'active' if request.httprequest.path in ['/my', '/my/home'] else ''}">
                <i class="fa fa-home"/><span>Inicio</span><i class="fa fa-angle-right cabrera-nav-arrow"/>
            </a>
            <a href="/my/orders" t-attf-class="cabrera-nav-item #{'active' if request.httprequest.path.startswith('/my/orders') else ''}">
                <i class="fa fa-shopping-cart"/><span>Mis pedidos</span><i class="fa fa-angle-right cabrera-nav-arrow"/>
            </a>
            <a href="/my/invoices" t-attf-class="cabrera-nav-item #{'active' if request.httprequest.path.startswith('/my/invoices') else ''}">
                <i class="fa fa-file-text-o"/><span>Mis facturas</span><i class="fa fa-angle-right cabrera-nav-arrow"/>
            </a>
            <a href="/my/returns" t-attf-class="cabrera-nav-item #{'active' if request.httprequest.path.startswith('/my/returns') else ''}">
                <i class="fa fa-reply"/><span>Mis devoluciones</span><i class="fa fa-angle-right cabrera-nav-arrow"/>
            </a>
            <a href="/my/product-lists" t-attf-class="cabrera-nav-item #{'active' if request.httprequest.path.startswith('/my/product-lists') else ''}">
                <i class="fa fa-heart-o"/><span>Mis favoritos</span><i class="fa fa-angle-right cabrera-nav-arrow"/>
            </a>
            <a href="/my/quotes" t-attf-class="cabrera-nav-item #{'active' if request.httprequest.path.startswith('/my/quotes') else ''}">
                <i class="fa fa-calculator"/><span>Mis presupuestos</span><i class="fa fa-angle-right cabrera-nav-arrow"/>
            </a>
            <a href="/my/account" t-attf-class="cabrera-nav-item #{'active' if request.httprequest.path.startswith('/my/account') else ''}">
                <i class="fa fa-user-o"/><span>Mis datos personales</span><i class="fa fa-angle-right cabrera-nav-arrow"/>
            </a>
            <a href="/my/security" t-attf-class="cabrera-nav-item #{'active' if request.httprequest.path.startswith('/my/security') else ''}">
                <i class="fa fa-lock"/><span>Cambiar contraseña</span><i class="fa fa-angle-right cabrera-nav-arrow"/>
            </a>
            <a href="/shop" class="cabrera-nav-item">
                <i class="fa fa-building-o"/><span>Mi tienda profesional</span><i class="fa fa-angle-right cabrera-nav-arrow"/>
            </a>
            <a href="/#contacto" class="cabrera-nav-item">
                <i class="fa fa-comments-o"/><span>Atención al Cliente</span><i class="fa fa-angle-right cabrera-nav-arrow"/>
            </a>
        </nav>
    </template>

    <template id="portal_layout_cabrera" inherit_id="portal.portal_layout" priority="80">
        <xpath expr="//div[@id='wrap' and hasclass('o_portal_wrap')]" position="attributes">
            <attribute name="class" add="cabrera-portal-shell" separator=" "/>
        </xpath>

        <!-- Odoo muestra "Mi cuenta" encima del home por el modo my_details. Nuestra cabecera ya lo sustituye. -->
        <xpath expr="//div[hasclass('wrapper')]/h3[hasclass('my-3')]" position="replace"/>

        <!-- Eliminamos el acceso móvil estándar de Odoo (avatar con la inicial)
             y su panel lateral de datos, porque la navegación móvil personalizada
             ya cubre esa función. -->
        <xpath expr="//button[@data-bs-target='#accountOffCanvas']" position="replace"/>
        <xpath expr="//div[@id='accountOffCanvas']" position="replace"/>

        <xpath expr="//div[@id='wrap' and hasclass('o_portal_wrap')]/div[hasclass('container')][1]" position="before">
            <!-- Menú lateral de escritorio -->
            <aside class="cabrera-portal-sidebar d-print-none">
                <t t-call="mi_cuenta_extendida_usuario.cabrera_portal_navigation"/>
            </aside>

            <!-- Acceso al menú de cuenta en tablet/móvil -->
            <div class="cabrera-mobile-menu-bar d-lg-none d-print-none">
                <button class="cabrera-mobile-menu-button"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#cabreraPortalMenu"
                        aria-controls="cabreraPortalMenu"
                        aria-label="Abrir menú de mi cuenta">
                    <i class="fa fa-bars" aria-hidden="true"/>
                    <span>Mi cuenta</span>
                    <i class="fa fa-angle-right cabrera-mobile-menu-arrow" aria-hidden="true"/>
                </button>
            </div>

            <!-- Drawer móvil con la misma navegación del escritorio -->
            <div class="offcanvas offcanvas-start cabrera-portal-offcanvas d-lg-none d-print-none"
                 tabindex="-1"
                 id="cabreraPortalMenu"
                 aria-labelledby="cabreraPortalMenuLabel">
                <div class="offcanvas-header cabrera-offcanvas-header">
                    <div>
                        <span class="cabrera-offcanvas-eyebrow">Área profesional</span>
                        <h5 class="offcanvas-title" id="cabreraPortalMenuLabel">Mi cuenta</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"/>
                </div>
                <div class="offcanvas-body cabrera-offcanvas-body">
                    <t t-call="mi_cuenta_extendida_usuario.cabrera_portal_navigation"/>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
