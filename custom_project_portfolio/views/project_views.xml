<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Vista de gestión de categorías -->
    <record id="view_portfolio_category_list" model="ir.ui.view">
        <field name="name">project.portfolio.category.list</field>
        <field name="model">project.portfolio.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color"/>
            </list>
        </field>
    </record>

    <record id="action_portfolio_categories" model="ir.actions.act_window">
        <field name="name">Categorías de Portfolio</field>
        <field name="res_model">project.portfolio.category</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menú en Proyecto -->
    <menuitem id="menu_portfolio_categories"
              name="Categorías Portfolio"
              parent="project.menu_main_pm"
              action="action_portfolio_categories"
              sequence="99"/>

    <!-- Pestaña Portfolio en el formulario del proyecto -->
    <record id="view_project_form_portfolio" model="ir.ui.view">
        <field name="name">project.project.form.portfolio</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">
                <page string="Portfolio Web">

                    <group>
                        <field name="is_published_portfolio"/>
                        <field name="portfolio_title"/>
                        <field name="portfolio_category_id"/>
                        <field name="portfolio_description" widget="html"/>
                    </group>

                    <field name="portfolio_image_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="image" widget="image"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="image" widget="image"/>
                                </group>
                            </sheet>
                        </form>
                    </field>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
