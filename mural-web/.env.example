# --- Puerto publicado por Docker ---
# 127.0.0.1 es lo más seguro si el reverse proxy corre en el host.
MURAL_BIND_IP=127.0.0.1
MURAL_PORT=3001

# --- GPT-6 Luna vía Vercel AI Gateway ---
LLM_PROVIDER=vercel
AI_GATEWAY_API_KEY=replace_me
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_MODEL=openai/gpt-6-luna
LLM_REASONING_EFFORT=none
LLM_INPUT_USD_PER_M=0.10
LLM_OUTPUT_USD_PER_M=0.50
LLM_REFERENCE_CREDIT_USD=5

# --- Azure Speech ---
AZURE_SPEECH_KEY=replace_me
AZURE_SPEECH_FALLBACK_KEY=
AZURE_SPEECH_REGION=francecentral
AZURE_STT_FREE_SECONDS=18000
AZURE_STT_MAX_SESSION_SECONDS=300

# --- Google Chirp 3 HD ---
GOOGLE_CLOUD_PROJECT=replace_me
GOOGLE_CREDENTIALS_FILE=./mural-chirp.json
GOOGLE_TTS_FREE_CHARACTERS=1000000
GOOGLE_TTS_LANGUAGE=en-US
GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Charon

# --- Protección de uso ---
USAGE_SAFETY_PERCENT=98
