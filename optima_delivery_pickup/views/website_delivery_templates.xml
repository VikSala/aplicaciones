<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="delivery_form_generic_pickup" inherit_id="website_sale.delivery_form">
        <xpath expr="//li[@name='o_delivery_method']" position="attributes">
            <!-- Durante el desarrollo no ocultamos ningún método estándar. -->
            <attribute name="t-if">True</attribute>
        </xpath>

        <xpath expr="//ul[@id='o_delivery_methods']/t[@t-foreach='delivery_methods']" position="after">
            <li
                t-if="True"
                name="o_optima_pickup_method"
                class="list-group-item o_outline optima_pickup_method"
            >
                <div class="row flex-column flex-md-row flex-grow-1 gap-lg-3">
                    <div class="col">
                        <div class="d-flex form-check mb-0 gap-2">
                            <input
                                id="o_optima_pickup"
                                name="o_optima_pickup_radio"
                                type="radio"
                                class="form-check-input position-absolute"
                                t-att-checked="optima_pickup_selected"
                                t-att-data-resolved="'1' if optima_pickup_resolved else '0'"
                            />
                            <label class="o_delivery_carrier_label optima_pickup_label" for="o_optima_pickup">
                                <span class="fw-semibold">Punto de recogida</span>
                                <small class="d-block text-muted fw-normal mt-1">
                                    Recoge tu pedido donde te resulte más cómodo.
                                </small>
                            </label>
                        </div>
                    </div>
                    <div class="col col-auto">
                        <span class="o_wsale_delivery_price_badge float-end fw-bold optima_pickup_price" name="price">
                            <t t-if="optima_pickup_resolved">
                                <t t-esc="'%.2f %s' % (optima_pickup_price, optima_pickup_currency)"/>
                            </t>
                            <t t-elif="optima_pickup_point">Precio pendiente de cálculo</t>
                            <t t-else="">Selecciona un punto para calcular el precio</t>
                        </span>
                    </div>
                </div>

                <div
                    name="o_optima_pickup_location"
                    t-attf-class="position-relative mt-3 ms-md-4 {{'' if optima_pickup_selected else 'd-none'}}"
                >
                    <div
                        name="o_optima_pickup_details"
                        t-attf-class="optima_pickup_details {{'' if optima_pickup_point else 'd-none'}}"
                    >
                        <div class="d-flex align-items-start gap-2">
                            <i class="fa fa-map-marker mt-1" aria-hidden="true"/>
                            <div class="flex-grow-1">
                                <div class="fw-semibold" name="o_optima_pickup_name">
                                    <t t-esc="optima_pickup_point.get('name', '')"/>
                                </div>
                                <div class="small text-muted" name="o_optima_pickup_address">
                                    <t t-if="optima_pickup_point">
                                        <t t-esc="optima_pickup_point.get('street', '')"/>
                                        <br/>
                                        <t t-esc="optima_pickup_point.get('zip_code', '')"/>
                                        <t t-if="optima_pickup_point.get('city')">
                                            <t t-esc="' ' + optima_pickup_point.get('city')"/>
                                        </t>
                                    </t>
                                </div>
                                <div
                                    name="o_optima_pickup_carrier"
                                    t-attf-class="small text-muted mt-1 {{'' if optima_pickup_resolved and optima_pickup_delivery_carrier_name else 'd-none'}}"
                                >
                                    <t t-if="optima_pickup_resolved and optima_pickup_delivery_carrier_name">
                                        Método: <t t-esc="optima_pickup_delivery_carrier_name"/>
                                    </t>
                                </div>
                            </div>
                            <button type="button" name="o_optima_pickup_selector" class="btn btn-link btn-sm p-0 text-nowrap">
                                Cambiar punto
                            </button>
                        </div>
                    </div>

                    <button
                        t-attf-class="btn btn-outline-primary btn-sm {{'d-none' if optima_pickup_point else ''}}"
                        type="button"
                        name="o_optima_pickup_selector"
                    >
                        <i class="fa fa-map-marker me-1" aria-hidden="true"/>
                        Seleccionar punto de recogida
                    </button>

                    <div
                        name="o_optima_pickup_error"
                        t-attf-class="alert alert-warning py-2 px-3 mt-2 mb-0 {{'' if optima_pickup_resolution_message and not optima_pickup_resolved else 'd-none'}}"
                        role="alert"
                    >
                        <t t-if="optima_pickup_resolution_message and not optima_pickup_resolved" t-esc="optima_pickup_resolution_message"/>
                    </div>
                    <div class="small text-muted mt-2">
                        <t t-if="optima_pickup_resolved">
                            Método y precio calculados para el punto seleccionado.
                        </t>
                        <t t-else="">
                            Selecciona un punto para calcular el método de transporte y su precio.
                        </t>
                    </div>
                </div>
            </li>
        </xpath>
    </template>


    <template id="delivery_method_generic_pickup_selection" inherit_id="website_sale.delivery_method">
        <xpath expr="//input[@name='o_delivery_radio']" position="attributes">
            <attribute name="t-att-checked">is_selected and not order.optima_pickup_mode</attribute>
        </xpath>
    </template>

</odoo>
