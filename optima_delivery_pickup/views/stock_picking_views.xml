<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_optima_delivery" model="ir.ui.view">
        <field name="name">stock.picking.form.optima.delivery</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Método de entrega" name="optima_delivery">
                    <group string="Resumen operativo">
                        <group>
                            <field name="optima_delivery_snapshot_ready" readonly="1"/>
                            <field name="carrier_id" readonly="1"/>
                            <field name="optima_delivery_method_snapshot_id" readonly="1"/>
                            <field name="optima_delivery_expected_packaging" readonly="1"/>
                        </group>
                        <group>
                            <field name="optima_delivery_method_limits_text" readonly="1"/>
                            <field name="optima_delivery_preflight_status" readonly="1"/>
                            <field name="carrier_tracking_ref" readonly="1"/>
                            <field name="carrier_tracking_url" readonly="1" widget="url"/>
                        </group>
                    </group>

                    <group string="Embalaje esperado (1 bulto)" invisible="not optima_delivery_snapshot_ready">
                        <group>
                            <field name="optima_delivery_package_weight_kg" readonly="1"/>
                            <field name="optima_delivery_package_unit_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="optima_delivery_package_length_mm" readonly="1"/>
                            <field name="optima_delivery_package_width_mm" readonly="1"/>
                            <field name="optima_delivery_package_height_mm" readonly="1"/>
                        </group>
                    </group>

                    <group string="Punto de recogida" invisible="not optima_delivery_pickup_mode">
                        <group>
                            <field name="optima_delivery_pickup_provider_code" readonly="1"/>
                            <field name="optima_delivery_pickup_external_id" readonly="1"/>
                            <field name="optima_delivery_pickup_carrier_code" readonly="1"/>
                            <field name="optima_delivery_pickup_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="optima_delivery_pickup_street" readonly="1"/>
                            <field name="optima_delivery_pickup_zip" readonly="1"/>
                            <field name="optima_delivery_pickup_city" readonly="1"/>
                            <field name="optima_delivery_pickup_country_code" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
