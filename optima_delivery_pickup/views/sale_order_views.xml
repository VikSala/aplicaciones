<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_optima_pickup" model="ir.ui.view">
        <field name="name">sale.order.form.optima.pickup</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Método de entrega" name="optima_pickup">
                    <group string="Resumen de expedición">
                        <group>
                            <field name="optima_delivery_method_id" readonly="1"/>
                            <field name="optima_delivery_packaging_suggested" readonly="1"/>
                        </group>
                        <group>
                            <field name="optima_delivery_method_limits" readonly="1"/>
                        </group>
                    </group>

                    <group string="Validación logística (1 bulto)">
                        <group>
                            <field name="optima_pickup_logistics_ready" readonly="1"/>
                            <field name="optima_pickup_package_weight_kg" readonly="1"/>
                            <field name="optima_pickup_package_unit_count" readonly="1"/>
                            <field name="optima_pickup_package_strategy" readonly="1"/>
                        </group>
                        <group>
                            <field name="optima_pickup_package_length_mm" readonly="1"/>
                            <field name="optima_pickup_package_width_mm" readonly="1"/>
                            <field name="optima_pickup_package_height_mm" readonly="1"/>
                            <field name="optima_pickup_logistics_message" readonly="1"/>
                        </group>
                    </group>

                    <group string="Punto de recogida" invisible="not optima_pickup_mode">
                        <group>
                            <field name="optima_pickup_mode" readonly="1"/>
                            <field name="optima_pickup_provider_code" readonly="1"/>
                            <field name="optima_pickup_external_id" readonly="1"/>
                            <field name="optima_pickup_carrier_name" readonly="1"/>
                            <field name="optima_pickup_carrier_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="optima_pickup_name" readonly="1"/>
                            <field name="optima_pickup_street" readonly="1"/>
                            <field name="optima_pickup_zip" readonly="1"/>
                            <field name="optima_pickup_city" readonly="1"/>
                            <field name="optima_pickup_country_code" readonly="1"/>
                        </group>
                    </group>
                    <group string="Resolución de transporte" invisible="not optima_pickup_mode">
                        <group>
                            <field name="optima_pickup_resolved" readonly="1"/>
                            <field name="optima_pickup_delivery_carrier_id" readonly="1"/>
                            <field name="optima_pickup_delivery_price" readonly="1"/>
                        </group>
                        <group>
                            <field name="optima_pickup_resolution_message" readonly="1"/>
                        </group>
                    </group>
                    <group string="Coordenadas" invisible="not optima_pickup_mode">
                        <field name="optima_pickup_latitude" readonly="1"/>
                        <field name="optima_pickup_longitude" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
