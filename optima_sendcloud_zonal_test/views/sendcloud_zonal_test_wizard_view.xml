<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sendcloud_zonal_test_wizard_form" model="ir.ui.view">
        <field name="name">sendcloud.zonal.test.wizard.form</field>
        <field name="model">sendcloud.zonal.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Test Spain Shipping Methods">
                <group string="Connection">
                    <group>
                        <field name="company_id"/>
                        <field name="integration_id"/>
                        <field name="sender_address_id"/>
                    </group>
                    <group>
                        <field name="from_postal_code"/>
                        <field name="to_country_id"/>
                        <field name="to_postal_code"/>
                        <field name="service_point_id"/>
                    </group>
                </group>
                <group string="Display filters">
                    <field name="carrier_filter"/>
                    <field name="name_filter"/>
                </group>
                <separator string="Results"/>
                <group>
                    <group string="Current OCA-style query">
                        <field name="baseline_count" readonly="1"/>
                        <field name="baseline_match_count" readonly="1"/>
                        <field name="baseline_params" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Zonal query">
                        <field name="zonal_count" readonly="1"/>
                        <field name="zonal_match_count" readonly="1"/>
                        <field name="zonal_params" readonly="1" nolabel="1"/>
                    </group>
                </group>
                <field name="conclusion" readonly="1" nolabel="1"/>
                <notebook>
                    <page string="OCA-style matches">
                        <field name="baseline_results" readonly="1" nolabel="1"/>
                    </page>
                    <page string="Zonal matches">
                        <field name="zonal_results" readonly="1" nolabel="1"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_run_test" string="Run Test" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sendcloud_zonal_test_wizard" model="ir.actions.act_window">
        <field name="name">Test Spain Shipping Methods</field>
        <field name="res_model">sendcloud.zonal.test.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
