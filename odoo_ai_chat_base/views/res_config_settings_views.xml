<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_odoo_ai_chat_base" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.odoo.ai.chat.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AI Chat Base" name="odoo_ai_chat_base" data-string="AI Chat Base">
                    <block title="Chatbot">
                        <setting string="URL del webhook" help="Endpoint HTTP(S) al que Odoo enviará cada mensaje del chatbot.">
                            <field name="odoo_ai_chat_base_webhook_url" placeholder="https://n8n.example.com/webhook/odoo-ai-chat"/>
                        </setting>
                        <setting string="Título" help="Nombre visible en la cabecera del widget.">
                            <field name="odoo_ai_chat_base_title" placeholder="Asistente"/>
                        </setting>
                        <setting string="Mensaje de bienvenida" help="Primer mensaje que verá el visitante al abrir el chat.">
                            <field name="odoo_ai_chat_base_welcome_message" placeholder="Hola, ¿en qué puedo ayudarte?"/>
                        </setting>
                        <setting string="Páginas donde aparece" help="Selecciona las páginas del sitio donde debe cargarse el chatbot.">
                            <field
                                name="odoo_ai_chat_base_page_ids"
                                widget="many2many_tags"
                                placeholder="Selecciona páginas"
                                context="{'odoo_ai_chat_base_page_selector': True}"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
