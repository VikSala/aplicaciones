<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="amazon_s3_account_view_tree" model="ir.ui.view">
        <field name="name">amazon.s3.account.view.tree</field>
        <field name="model">amazon.s3.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="bucket_name"/>
                <field name="model_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="amazon_s3_account_view_form" model="ir.ui.view">
        <field name="name">amazon.s3.account.view.form</field>
        <field name="model">amazon.s3.account</field>
        <field name="arch" type="xml">
            <form string="S3 Account">
                <header>
                    <button name="action_test_connection"
                            type="object"
                            string="Test Connection"
                            class="oe_highlight"
                            icon="fa-plug"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Production Bucket"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Credentials">
                            <field name="access_key"/>
                            <field name="secret_key" password="True"/>
                        </group>
                        <group string="Bucket">
                            <field name="bucket_name"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Models to Sync" name="models_sync">
                            <field name="model_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Select models whose attachments will be uploaded..."/>
                            <div class="text-muted mt-2">
                                Attachments from the selected models will be
                                automatically uploaded to this S3 bucket by
                                the scheduled action.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="amazon_s3_account_action" model="ir.actions.act_window">
        <field name="name">S3 Accounts</field>
        <field name="res_model">amazon.s3.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Amazon S3 account
            </p>
            <p>
                Configure multiple S3 accounts with different buckets
                and choose which models to sync for each.
            </p>
        </field>
    </record>
</odoo>
