<odoo>
    <data noupdate="1">
        <record id="ir_cron_amazon_upload_attachment" model="ir.cron">
            <field name="name">Amazon Upload Attachment</field>
            <field name="model_id" ref="ms_amazon_s3_connector.model_amazon_dashboard"/>
            <field name="state">code</field>
            <field name="code">model.scheduler_action_amazon_upload()</field>
            <field name="interval_type">days</field>
            <field name="interval_number">1</field>
<!--            <field name="numbercall">-1</field>-->
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=23, minute=55)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
