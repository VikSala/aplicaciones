<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_optima_ecommerce_credit" model="ir.ui.view">
        <field name="name">account.move.form.optima.ecommerce.credit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="40"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="is_ecommerce" readonly="1" invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
