<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_optima_gls_tariff_import_wizard" model="ir.ui.view">
        <field name="name">optima.gls.tariff.import.wizard.form</field>
        <field name="model">optima.gls.tariff.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar tarifas GLS">
                <group>
                    <field name="file_data" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="enable_matching_carriers"/>
                </group>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
