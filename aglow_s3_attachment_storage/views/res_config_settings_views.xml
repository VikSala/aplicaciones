<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.s3_attachment_storage</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="S3 Attachment Storage" name="s3_attachment_settings">
                    <setting string="S3 Bucket"
                             help="Name of the S3 bucket for storing attachments">
                        <field name="s3_attachment_bucket"/>
                    </setting>
                    <setting string="Access Key ID"
                             help="AWS access key ID or equivalent for your S3 provider">
                        <field name="s3_attachment_access_key_id"/>
                    </setting>
                    <setting string="Secret Access Key"
                             help="AWS secret access key or equivalent for your S3 provider">
                        <field name="s3_attachment_secret_access_key" password="True"/>
                    </setting>
                    <setting string="Endpoint URL"
                             help="Leave empty for AWS S3. Set for S3-compatible services (MinIO, Backblaze B2, DigitalOcean Spaces).">
                        <field name="s3_attachment_endpoint_url"
                               placeholder="https://nyc3.digitaloceanspaces.com"/>
                    </setting>
                    <setting string="Region"
                             help="AWS region or provider region code">
                        <field name="s3_attachment_region" placeholder="us-east-1"/>
                    </setting>
                    <setting string="Object Key Prefix"
                             help="Optional. Leave empty for a dedicated bucket. Set a distinct prefix per instance (e.g. 'prod-a') only when several Odoo databases share one bucket, so each instance's garbage collection stays within its own objects.">
                        <field name="s3_attachment_key_prefix" placeholder="e.g. prod-a"/>
                    </setting>
                    <setting string="Production Only"
                             help="Only write to and delete from S3 on production Odoo SH builds. Staging and dev builds will still read from S3, but store new attachments locally.">
                        <field name="s3_attachment_production_only"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
