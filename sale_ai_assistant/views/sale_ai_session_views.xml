<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_ai_session_search" model="ir.ui.view">
        <field name="name">sale.ai.session.search</field>
        <field name="model">sale.ai.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sale_order_id"/>
                <filter string="En curso" name="active" domain="[('state','=','active')]"/>
                <filter string="Historial cerrado" name="history" domain="[('state','in',('completed','archived'))]"/>
                <group expand="0" string="Agrupar">
                    <filter string="Estado" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Compañía" name="group_company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_sale_ai_session_list" model="ir.ui.view">
        <field name="name">sale.ai.session.list</field>
        <field name="model">sale.ai.session</field>
        <field name="arch" type="xml">
            <list string="Conversaciones IA" delete="0">
                <field name="name"/>
                <field name="state"/>
                <field name="user_id" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="model_id" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="write_date" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_sale_ai_session_form" model="ir.ui.view">
        <field name="name">sale.ai.session.form</field>
        <field name="model">sale.ai.session</field>
        <field name="arch" type="xml">
            <form string="Conversación IA" delete="0">
                <header>
                    <button name="action_close" type="object" string="Cerrar" class="btn-secondary"
                            invisible="state != 'consultation'"/>
                    <button name="action_reopen" type="object" string="Reabrir para consulta" class="btn-secondary"
                            invisible="state not in ('archived','completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,archived,completed,consultation"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="state != 'active'"/></h1></div>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="model_id" readonly="state not in ('active','consultation')"/>
                        </group>
                        <group>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="edit_order_id" readonly="1"/>
                            <field name="ended_at" readonly="1"/>
                            <field name="reopened_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Borrador provisional">
                            <field name="draft_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="description"/>
                                    <field name="partner_id"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount_untaxed_estimate"/>
                                </list>
                            </field>
                            <div class="text-muted">Abre el borrador desde su fila para revisar o editar sus líneas mientras la sesión siga en curso.</div>
                        </page>
                        <page string="Mensajes (historial)">
                            <field name="message_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="create_date"/>
                                    <field name="role"/>
                                    <field name="content"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contexto resumido (futuro)">
                            <field name="summary" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sale_ai_session" model="ir.actions.act_window">
        <field name="name">Conversaciones IA</field>
        <field name="res_model">sale.ai.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sale_ai_session_search"/>
    </record>
</odoo>
