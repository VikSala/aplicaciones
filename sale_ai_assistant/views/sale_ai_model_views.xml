<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_ai_model_list" model="ir.ui.view">
        <field name="name">sale.ai.model.list</field>
        <field name="model">sale.ai.model</field>
        <field name="arch" type="xml">
            <list string="Modelos disponibles">
                <field name="name"/>
                <field name="model_type"/>
                <field name="provider"/>
                <field name="external_model_id"/>
                <field name="gateway_routing" optional="show"/>
                <field name="gateway_fixed_provider" optional="hide"/>
                <field name="gateway_fallback_provider" optional="hide"/>
                <field name="is_default" readonly="1"/>
                <field name="supports_tools"/>
                <field name="supports_images"/>
                <field name="supports_pdf"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_sale_ai_model_form" model="ir.ui.view">
        <field name="name">sale.ai.model.form</field>
        <field name="model">sale.ai.model</field>
        <field name="arch" type="xml">
            <form string="Modelo de IA">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_type"/>
                            <field name="provider" invisible="model_type == 'profile'"/>
                            <field name="external_model_id" invisible="model_type == 'profile'" required="model_type == 'individual'"/>
                            <field name="active"/>
                            <field name="is_default"/>
                            <div class="text-muted" colspan="2">
                                Predeterminado para la compañía activa. Marcarlo sustituye
                                automáticamente el anterior; no modifica los chats existentes.
                            </div>
                        </group>
                        <group string="Capacidades declaradas (verificar con el proveedor)" invisible="model_type == 'profile'">
                            <field name="supports_tools"/>
                            <div class="text-muted" colspan="2">
                                Necesario para que la IA consulte Odoo. Actívalo solo tras
                                comprobar que el modelo admite llamadas a funciones en Vercel.
                            </div>
                            <field name="supports_images"/>
                            <field name="supports_pdf"/>
                            <field name="supports_text_files"/>
                            <field name="supports_native_web_search"/>
                            <field name="context_window_tokens"/>
                        </group>
                    </group>
                    <group string="Perfil multimodelo — seleccionar modelos ya registrados" invisible="model_type != 'profile'">
                        <group>
                            <field name="description_model_id" required="model_type == 'profile'" options="{'no_create': True}"/>
                            <field name="market_model_id" required="model_type == 'profile'" options="{'no_create': True}"/>
                            <field name="commercial_model_id" required="model_type == 'profile'" options="{'no_create': True}"/>
                            <field name="description_style"/>
                        </group>
                        <group>
                            <field name="tools_model_id" required="model_type == 'profile'" options="{'no_create': True}"/>
                            <field name="review_model_id" required="model_type == 'profile'" options="{'no_create': True}"/>
                            <field name="fallback_model_id" required="model_type == 'profile'" options="{'no_create': True}"/>
                        </group>
                        <div class="text-muted" colspan="2">
                            Un perfil comparte conversación y borrador. Las operaciones de Odoo las realiza
                            el modelo de herramientas; los modelos de redacción y síntesis reciben resultados
                            de lectura. Se recurrirá al fallback ante errores recuperables, sin repetir escrituras confirmadas.
                        </div>
                    </group>
                    <group string="Enrutamiento Vercel por modelo" invisible="model_type == 'profile'">
                        <field name="gateway_routing"/>
                        <field name="gateway_fixed_provider" invisible="gateway_routing != 'fixed'" required="model_type == 'individual' and gateway_routing == 'fixed'"/>
                        <field name="gateway_fallback_provider" invisible="gateway_routing != 'fixed'" placeholder="Opcional: slug del segundo proveedor"/>
                        <div class="text-muted" colspan="2">En «Proveedor específico» se intenta el principal y, si configuras un respaldo, únicamente ese segundo proveedor si el primero falla o no está disponible. No se permite usar otros proveedores. Ambos deben ofrecer el mismo modelo. Sin respaldo solo se utiliza el principal. Las demás políticas mantienen el enrutamiento habitual de Vercel.</div>
                        <div class="text-muted" colspan="2">La prioridad por coste clasifica por tarifa de entrada. El coste final y el proveedor que atendió la solicitud se consultan desde «Consumo por modelo», sin tarifas manuales.</div>
                    </group>
                    <group>
                        <field name="notes" placeholder="Coste, calidad, límites observados, enlaces a la ficha del modelo..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sale_ai_model" model="ir.actions.act_window">
        <field name="name">Modelos IA</field>
        <field name="res_model">sale.ai.model</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
