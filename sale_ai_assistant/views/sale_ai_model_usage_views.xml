<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_ai_model_usage_list" model="ir.ui.view">
        <field name="name">sale.ai.model.usage.list</field>
        <field name="model">sale.ai.model.usage</field>
        <field name="arch" type="xml">
            <list string="Consumo por modelo" create="0" edit="0" delete="0">
                <header><button name="action_refresh_gateway_costs" type="object" string="Consultar costes pendientes en Vercel" display="always" class="btn-primary"/></header>
                <field name="create_date"/>
                <field name="session_id"/>
                <field name="model_id"/>
                <field name="stage"/>
                <field name="status"/>
                <field name="turn_ref"/>
                <field name="event_kind"/>
                <field name="diagnostic_operation"/>
                <field name="error_type"/>
                <field name="turn_elapsed_ms"/>
                <field name="input_tokens" sum="Tokens"/>
                <field name="output_tokens" sum="Tokens"/>
                <field name="provider_name"/>
                <field name="generation_id" optional="hide"/>
                <field name="cost_status"/>
                <field name="reported_cost_usd" sum="USD confirmados"/>
                <field name="latency_ms"/>
            </list>
        </field>
    </record>
    <record id="view_sale_ai_model_usage_form" model="ir.ui.view">
        <field name="name">sale.ai.model.usage.form</field>
        <field name="model">sale.ai.model.usage</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group><field name="session_id"/><field name="model_id"/>
                        <field name="stage"/><field name="status"/>
                <field name="turn_ref"/>
                <field name="event_kind"/>
                <field name="diagnostic_operation"/>
                <field name="error_type"/>
                <field name="turn_elapsed_ms"/>
                        <field name="input_tokens"/><field name="output_tokens"/>
                        <field name="latency_ms"/>
                        <field name="generation_id"/>
                        <field name="provider_name"/>
                        <field name="cost_status"/>
                        <field name="reported_cost_usd"/>
                        <field name="cost_lookup_attempts"/></group>
                    <group><field name="error_message"/><field name="fallback_reason"/><field name="result_text"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_sale_ai_model_usage_search" model="ir.ui.view">
        <field name="name">sale.ai.model.usage.search</field>
        <field name="model">sale.ai.model.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="turn_ref"/>
                <field name="session_id"/>
                <field name="model_id"/>
                <field name="error_type"/>
                <filter name="failed" string="Fallos" domain="[('status', '=', 'failed')]"/>
                <filter name="pending_cost" string="Coste pendiente" domain="[('cost_status', '=', 'pending')]"/>
                <filter name="confirmed_cost" string="Coste confirmado" domain="[('cost_status', '=', 'obtained')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="by_turn" string="Referencia" context="{'group_by': 'turn_ref'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_sale_ai_model_usage" model="ir.actions.act_window">
        <field name="name">Consumo por modelo</field>
        <field name="res_model">sale.ai.model.usage</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sale_ai_model_usage_search"/>
    </record>
</odoo>
