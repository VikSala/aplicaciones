<odoo>
    <record id="view_product_attribute_form_range" model="ir.ui.view">
        <field name="name">product.attribute.form.range</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_type']" position="after">
                <field name="wcf_is_range_filter"/>
                <label for="range_min" string="Límites del Slider" invisible="not wcf_is_range_filter and display_type != 'range'"/>
                <div class="o_row" invisible="not wcf_is_range_filter and display_type != 'range'">
                    <field name="range_min" placeholder="Mínimo"/>
                    <span> a </span>
                    <field name="range_max" placeholder="Máximo"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>